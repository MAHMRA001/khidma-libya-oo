{
  "name": "JobPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "title_ar": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "electrician",
        "plumber",
        "painter",
        "builder",
        "cleaner",
        "mechanic",
        "barber",
        "car_workshop",
        "cctv_installation",
        "phone_repair",
        "appliance_repair",
        "ac_repair",
        "moving_help",
        "home_repair",
        "car_towing",
        "heavy_vehicle_rental",
        "housekeeping",
        "language_courses",
        "tutoring",
        "other"
      ]
    },
    "city": {
      "type": "string",
      "enum": [
        "Tripoli",
        "Benghazi",
        "Misrata",
        "Sabha",
        "Zawiya",
        "Zliten",
        "Ajdabiya",
        "Sirte",
        "Tobruk",
        "Derna",
        "Gharyan",
        "Sabratha",
        "Khoms",
        "Tarhuna",
        "Zintan",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "description_ar": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "urgency": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ],
      "default": "normal"
    },
    "contact_method": {
      "type": "string",
      "enum": [
        "phone",
        "whatsapp",
        "in_app"
      ],
      "default": "phone"
    },
    "contact_info": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "poster_email": {
      "type": "string"
    },
    "poster_name": {
      "type": "string"
    },
    "is_promoted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "category",
    "city",
    "description",
    "contact_info"
  ]
}