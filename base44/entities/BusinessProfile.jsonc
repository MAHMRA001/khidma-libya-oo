{
  "name": "BusinessProfile",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "business_name_ar": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "electrician",
        "plumber",
        "painter",
        "builder",
        "cleaner",
        "mechanic",
        "barber",
        "car_workshop",
        "cctv_installation",
        "phone_repair",
        "appliance_repair",
        "ac_repair",
        "moving_help",
        "home_repair",
        "car_towing",
        "heavy_vehicle_rental",
        "other"
      ]
    },
    "city": {
      "type": "string",
      "enum": [
        "Tripoli",
        "Benghazi",
        "Misrata",
        "Sabha",
        "Zawiya",
        "Zliten",
        "Ajdabiya",
        "Sirte",
        "Tobruk",
        "Derna",
        "Gharyan",
        "Sabratha",
        "Khoms",
        "Tarhuna",
        "Zintan",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "description_ar": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "logo": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_type": {
      "type": "string",
      "enum": [
        "walk_in",
        "home_visit",
        "both"
      ],
      "default": "both"
    },
    "working_hours": {
      "type": "string",
      "description": "e.g. 8am - 6pm"
    },
    "working_days": {
      "type": "string",
      "description": "e.g. Sat-Thu"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "rejection_reason": {
      "type": "string"
    },
    "avg_rating": {
      "type": "number",
      "default": 0
    },
    "review_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "business_name",
    "category",
    "city",
    "phone"
  ]
}