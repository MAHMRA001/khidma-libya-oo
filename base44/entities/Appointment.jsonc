{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "service_description": {
      "type": "string"
    },
    "preferred_date": {
      "type": "string"
    },
    "preferred_time": {
      "type": "string"
    },
    "appointment_type": {
      "type": "string",
      "enum": [
        "walk_in",
        "home_visit"
      ],
      "default": "walk_in"
    },
    "address": {
      "type": "string",
      "description": "Customer address for home visits"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "customer_phone",
    "preferred_date"
  ]
}