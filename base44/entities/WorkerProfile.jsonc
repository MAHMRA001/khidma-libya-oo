{
  "name": "WorkerProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the worker user"
    },
    "full_name": {
      "type": "string",
      "description": "Worker's full name"
    },
    "full_name_ar": {
      "type": "string",
      "description": "Worker's full name in Arabic"
    },
    "city": {
      "type": "string",
      "enum": [
        "Tripoli",
        "Benghazi",
        "Misrata",
        "Sabha",
        "Zawiya",
        "Zliten",
        "Ajdabiya",
        "Sirte",
        "Tobruk",
        "Derna",
        "Gharyan",
        "Sabratha",
        "Khoms",
        "Tarhuna",
        "Zintan",
        "Other"
      ],
      "description": "City in Libya"
    },
    "nationality": {
      "type": "string",
      "description": "Worker nationality"
    },
    "category": {
      "type": "string",
      "enum": [
        "electrician",
        "plumber",
        "painter",
        "builder",
        "cleaner",
        "mechanic",
        "carpenter",
        "ac_repair",
        "moving_help",
        "home_repair",
        "other"
      ],
      "description": "Service category"
    },
    "description": {
      "type": "string",
      "description": "Service description in English"
    },
    "description_ar": {
      "type": "string",
      "description": "Service description in Arabic"
    },
    "profile_photo": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "work_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos of previous work"
    },
    "id_document": {
      "type": "string",
      "description": "Passport or national ID photo URL"
    },
    "selfie_photo": {
      "type": "string",
      "description": "Selfie for verification"
    },
    "price_min": {
      "type": "number",
      "description": "Minimum price (LYD)"
    },
    "price_max": {
      "type": "number",
      "description": "Maximum price (LYD)"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp number"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "unavailable"
      ],
      "default": "available"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "avg_rating": {
      "type": "number",
      "default": 0
    },
    "review_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "full_name",
    "city",
    "category",
    "phone"
  ]
}