{
  "name": "WorkerProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the worker user"
    },
    "full_name": {
      "type": "string"
    },
    "full_name_ar": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "enum": [
        "Tripoli",
        "Benghazi",
        "Misrata",
        "Sabha",
        "Zawiya",
        "Zliten",
        "Ajdabiya",
        "Sirte",
        "Tobruk",
        "Derna",
        "Gharyan",
        "Sabratha",
        "Khoms",
        "Tarhuna",
        "Zintan",
        "Other"
      ]
    },
    "nationality": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "electrician",
        "plumber",
        "painter",
        "builder",
        "cleaner",
        "mechanic",
        "barber",
        "car_workshop",
        "cctv_installation",
        "phone_repair",
        "appliance_repair",
        "ac_repair",
        "moving_help",
        "home_repair",
        "car_towing",
        "heavy_vehicle_rental",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "description_ar": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "work_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id_document": {
      "type": "string"
    },
    "selfie_photo": {
      "type": "string"
    },
    "price_min": {
      "type": "number"
    },
    "price_max": {
      "type": "number"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "unavailable"
      ],
      "default": "available"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "rejection_reason": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "avg_rating": {
      "type": "number",
      "default": 0
    },
    "review_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "full_name",
    "city",
    "category",
    "phone"
  ]
}