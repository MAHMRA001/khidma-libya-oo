{
  "name": "Review",
  "type": "object",
  "properties": {
    "worker_profile_id": {
      "type": "string",
      "description": "ID of the worker being reviewed"
    },
    "reviewer_email": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "worker_profile_id",
    "rating"
  ]
}