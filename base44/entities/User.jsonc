{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "customer",
        "worker"
      ],
      "default": "customer"
    },
    "phone": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "default": "en"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "customer",
        "worker"
      ],
      "default": "customer"
    },
    "city": {
      "type": "string"
    }
  }
}